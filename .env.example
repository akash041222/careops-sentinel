# Copy to .env and export, or set in your shell / hosting provider.
CAREOPS_SECRET_KEY=change-me-to-a-long-random-string   # REQUIRED in production (python -c "import secrets;print(secrets.token_hex(32))")
CAREOPS_DEMO_MODE=1            # 0 hides the demo-account helper on the login page
CAREOPS_DEMO_PASSWORD=CareOps@123
CAREOPS_SEED_DEMO=1            # 0 = do not pre-load synthetic sample requests
CAREOPS_CORS=http://localhost:5173
CAREOPS_LOW_CONFIDENCE=0.70
CAREOPS_TOKEN_TTL_MIN=480

# --- Optional LLM (RAG answer generation). Leave ANTHROPIC_API_KEY empty to run in extractive mode.
ANTHROPIC_API_KEY=
CAREOPS_LLM_MODEL=claude-sonnet-5-5
CAREOPS_LLM_TIMEOUT=20
